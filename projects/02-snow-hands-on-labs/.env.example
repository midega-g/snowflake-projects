# Shared by every badge in 02-snow-hands-on-labs. Copy to .env (gitignored) and fill in.
# Values: Snowsight > user menu > Account > View account details.
PROJECT_ENV=dev
PROJECT_OWNER=midega-g
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_ACCOUNT=orgname-accountname
# key-pair auth uses the LOGIN NAME, not the user name
SNOWFLAKE_USER=YOUR_LOGIN_NAME
# private key lives outside the repo, chmod 600
SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/private_key.p8
