# 03-zero-to-agents. Copy to .env (gitignored, chmod 600) and fill in.
# Values: Snowsight > user menu > Account > View account details.
PROJECT_ENV=dev
PROJECT_OWNER=midega-g
# ACCOUNTADMIN only until sql/02 has run. Then change to SNOWFLAKE_INTELLIGENCE_ADMIN.
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_ACCOUNT=orgname-accountname
# password auth uses the LOGIN NAME
SNOWFLAKE_USER=YOUR_LOGIN_NAME
# read by the snow CLI from the environment, so it is never written to connections.toml
SNOWFLAKE_PASSWORD=
